<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categoria Cadastrada</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="min-vh-100 d-flex flex-column">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Loja de Instrumentos Musicais</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacao">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavegacao">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/instrumento/lst">Instrumentos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/categoria/lst">Categorias</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fornecedor/lst">Fornecedores</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-5 flex-grow-1">

        <div class="alert alert-success">
            <h2>Categoria cadastrada com sucesso!</h2>

            <p>
                A categoria <strong>
                    <%= categoria.nome %>
                </strong>
                foi registrada no sistema.
            </p>
        </div>

        <a href="/categoria/add" class="btn btn-primary">
            Cadastrar outra categoria
        </a>

        <a href="/categoria/lst" class="btn btn-secondary">
            Ver categorias
        </a>

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-4">
        <p class="mb-1">Sistema Administrativo de uma Loja de Instrumentos Musicais</p>
        <small>Projeto desenvolvido pelos alunos do Polo Rosário do Sul.</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listagem de Categorias</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="min-vh-100 d-flex flex-column">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">
                Loja de Instrumentos Musicais
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacao">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavegacao">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/instrumento/lst">Instrumentos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/categoria/lst">Categorias</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/fornecedor/lst">Fornecedores</a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>

    <main class="container mt-5 flex-grow-1">

        <h1 class="mb-4">Categorias</h1>

        <a href="/categoria/add" class="btn btn-primary mb-3">
            Nova Categoria
        </a>

        <form action="/categoria/lst" method="GET" class="mb-4">
            <div class="input-group">
                <input type="text" name="busca" class="form-control" placeholder="Pesquisar categoria..."
                    value="<%= busca || '' %>">
                <button type="submit" class="btn btn-primary">
                    Pesquisar
                </button>
            </div>
        </form>

        <% if (categorias.length> 0) { %>

            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    <% categorias.forEach(categoria=> { %>
                        <tr>
                            <td>
                                <%= categoria.nome %>
                            </td>
                            <td>
                                <%= categoria.descricao || '-' %>
                            </td>
                            <td>
                                <a href="/categoria/view/<%= categoria._id %>" class="btn btn-info btn-sm">
                                    Visualizar
                                </a>
                                <a href="/categoria/edit/<%= categoria._id %>" class="btn btn-warning btn-sm">
                                    Editar
                                </a>
                                <form action="/categoria/delete" method="POST" style="display:inline;">
                                    <input type="hidden" name="id" value="<%= categoria._id %>">
                                    <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Deseja realmente excluir esta categoria?')">
                                        Excluir
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>

            </table>

            <% } else { %>

                <div class="alert alert-info">
                    Nenhuma categoria cadastrada.
                </div>

                <% } %>

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-4">
        <div class="container">
            <p class="mb-0">Sistema Administrativo de uma Loja de Instrumentos Musicais</p>
            <small>Projeto desenvolvido pelos alunos do Polo Rosário do Sul.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
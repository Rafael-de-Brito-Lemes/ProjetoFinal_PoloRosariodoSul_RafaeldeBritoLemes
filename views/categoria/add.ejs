<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Categoria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Menu de navegação -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">
                Loja de Instrumentos Musicais
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacao">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavegacao">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/instrumento/lst">Instrumentos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/categoria/lst">Categorias</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/fornecedor/lst">Fornecedores</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <div class="container mt-5">

        <h1 class="mb-4">Cadastrar Categoria</h1>

        <form action="/categoria/add/ok" method="POST">

            <div class="mb-3">
                <label for="nome" class="form-label">Nome da categoria</label>
                <input type="text" class="form-control" id="nome" name="nome" required>
            </div>

            <div class="mb-3">
                <label for="descricao" class="form-label">Descrição</label>
                <textarea class="form-control" id="descricao" name="descricao" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Cadastrar
            </button>

            <a href="/categoria/lst" class="btn btn-secondary">
                Voltar à listagem
            </a>

        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visualizar Fornecedor</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="min-vh-100 d-flex flex-column">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Loja de Instrumentos Musicais</a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Início</a>
                <a class="nav-link" href="/instrumento/lst">Instrumentos</a>
                <a class="nav-link" href="/categoria/lst">Categorias</a>
                <a class="nav-link active" href="/fornecedor/lst">Fornecedores</a>
            </div>
        </div>
    </nav>

    <main class="container mt-5 flex-grow-1">

        <h1 class="mb-4">Detalhes do Fornecedor</h1>

        <div class="card">
            <div class="card-body">

                <h3 class="card-title">
                    <%= fornecedor.nome %>
                </h3>

                <p>
                    <strong>Telefone:</strong>
                    <%= fornecedor.telefone %>
                </p>

                <p>
                    <strong>E-mail:</strong>
                    <%= fornecedor.email || 'Não informado' %>
                </p>

                <p>
                    <strong>Endereço:</strong>
                    <%= fornecedor.endereco || 'Não informado' %>
                </p>

                <a href="/fornecedor/lst" class="btn btn-secondary">
                    Voltar à listagem
                </a>

                <a href="/fornecedor/edit/<%= fornecedor._id %>" class="btn btn-warning">
                    Editar
                </a>

            </div>
        </div>

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-4">
        <p class="mb-1">Sistema Administrativo de uma Loja de Instrumentos Musicais</p>
        <small>Projeto desenvolvido pelos alunos do Polo Rosário do Sul.</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>